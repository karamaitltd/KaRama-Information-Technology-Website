{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "ar|ar-SA" }], "destination": "/ar/", "permanent": true },
    { "source": "/:page(expertise|possibilities|automations|approach|contact).html", "has": [{ "type": "query", "key": "lang", "value": "ar|ar-SA" }], "destination": "/ar/:page.html", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/ar/index.html", "destination": "/ar/", "permanent": true }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "assets/karama-logo-horizontal.png"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
